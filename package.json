{
  "name": "fullstack-hosting-platform-starter-mevn-stack",
  "version": "1.0.0",
  "description": "MEVN stack starter for a full-stack web hosting platform.",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "run-p dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "npm run dev --workspace backend",
    "build": "run-s build:frontend build:backend",
    "build:frontend": "run-p type-check \"build-only {@}\" --",
    "build:backend": "npm run build --workspace backend",
    "preview": "vite preview",
    "test": "run-s test:unit test:backend",
    "test:unit": "vitest run",
    "test:backend": "npm test --workspace backend",
    "test:e2e": "playwright test",
    "seed:offers": "npm run seed:offers --workspace backend",
    "setup:admin": "npm run setup:admin --workspace backend --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@clerk/vue": "^2.3.3",
    "@heroicons/vue": "^2.2.0",
    "@iconify-json/simple-icons": "^1.2.85",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
